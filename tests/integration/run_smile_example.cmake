# End-to-end check of the smile example: it runs, exits 0, and writes the three CSV files with the
# expected headers and row counts. Arguments: -DEXE=... -DSCENARIOS=... -DWORK=...
file(REMOVE_RECURSE "${WORK}")
execute_process(COMMAND "${EXE}" "${SCENARIOS}" "${WORK}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "fxval-example-smile exited ${rc}: ${err}")
endif()
foreach(name smile_curves smile_pivots smile_checks)
  if(NOT EXISTS "${WORK}/${name}.csv")
    message(FATAL_ERROR "missing ${name}.csv")
  endif()
endforeach()
file(STRINGS "${WORK}/smile_curves.csv" curve_lines)
list(LENGTH curve_lines n_curves)
file(STRINGS "${WORK}/smile_pivots.csv" pivot_lines)
list(LENGTH pivot_lines n_pivots)
file(STRINGS "${SCENARIOS}" scenario_lines REGEX "^[a-z_0-9]+,[0-9A-Z]+,")
list(LENGTH scenario_lines n_rows)
math(EXPR expected_curves "1 + ${n_rows} * 161")
math(EXPR expected_pivots "1 + ${n_rows}")
if(NOT n_curves EQUAL expected_curves OR NOT n_pivots EQUAL expected_pivots)
  message(FATAL_ERROR "row counts: curves ${n_curves} (want ${expected_curves}), pivots ${n_pivots} (want ${expected_pivots})")
endif()
list(GET curve_lines 0 header)
if(NOT header STREQUAL "scenario,tenor,expiry_years,x,strike,vol,density_factor")
  message(FATAL_ERROR "unexpected header: ${header}")
endif()
file(READ "${WORK}/smile_checks.csv" checks)
foreach(word "flat,1M,calendar,801,0," "calendar_inversion,2W,calendar,801,801,")
  string(FIND "${checks}" "${word}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "smile_checks.csv lacks the expected line starting '${word}'")
  endif()
endforeach()
