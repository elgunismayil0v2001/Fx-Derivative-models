# Writes build_info.hpp for the apps. Run at BUILD time (not configure time), so the recorded git
# commit is the one that is checked out when the program is built, not the one that happened to
# be checked out when cmake was first run.
#
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -DCOMPILER=... -DBUILD_TYPE=... -P GenBuildInfo.cmake
#
# Outside a git work tree (a source archive) the commit is "unknown". "-dirty" means tracked
# files differ from HEAD. Untracked files (build trees) do not count.
find_package(Git QUIET)
set(_commit "unknown")
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse --short=12 HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE _head
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _rc
    ERROR_QUIET)
  if(_rc EQUAL 0 AND NOT _head STREQUAL "")
    set(_commit "${_head}")
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD --
      WORKING_DIRECTORY "${SOURCE_DIR}"
      RESULT_VARIABLE _dirty
      ERROR_QUIET)
    if(NOT _dirty EQUAL 0)
      set(_commit "${_commit}-dirty")
    endif()
  endif()
endif()

set(_content "// Generated by cmake/GenBuildInfo.cmake at build time. Do not edit.
#pragma once
namespace fxval::app::build_info {
inline constexpr const char* git_commit = \"${_commit}\";
inline constexpr const char* compiler = \"${COMPILER}\";
inline constexpr const char* build_type = \"${BUILD_TYPE}\";
}  // namespace fxval::app::build_info
")
# Touch the file only when the content changes, so an unchanged commit does not rebuild the apps.
set(_old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUTPUT}" "${_content}")
endif()
